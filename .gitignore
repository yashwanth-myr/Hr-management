# Node.js
node_modules/
.pnpm-store/ # For pnpm package manager

# Next.js
.next/
out/

# Production
build/
dist/

# dotenv environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local # Catch-all for local environment variables

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo
*.DS_Store
Thumbs.db

# macOS specific files
